# 保证脚本换行符为 LF，避免 CRLF 破坏 recovery / magisk 的 shell 脚本
* text=auto eol=lf

*.sh            text eol=lf
*.prop          text eol=lf
*.md            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
.env            text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

magisk-template/META-INF/com/google/android/update-binary  text eol=lf
magisk-template/META-INF/com/google/android/updater-script text eol=lf

*.zip  binary
